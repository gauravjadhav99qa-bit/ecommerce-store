generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  gender        String?
  dob           DateTime?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  reviews  Review[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  image     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Int
  compareAt   Int?
  images      String  @default("[]")
  sku         String?  @unique
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false)
  isDigital   Boolean  @default(false)
  downloadUrl String?

  // Digital product metadata
  productType     ProductType @default(SINGLE)
  tags            String      @default("[]")
  pageCount       Int?
  paperSize       String?
  fileFormat      String?
  printInstructions String?
  license         String?

  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category    Category?     @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  orderItems  OrderItem[]
  reviews     Review[]
  files       ProductFile[]
  bundleItems BundleItem[]  @relation("BundleContents")
  bundles     BundleItem[]  @relation("InBundle")

  @@index([categoryId])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

enum ProductType {
  SINGLE
  BUNDLE
}

model ProductFile {
  id          String  @id @default(cuid())
  productId   String
  fileName    String
  storagePath String
  mimeType    String  @default("application/pdf")
  sizeBytes   Int     @default(0)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_files")
}

model BundleItem {
  id         String  @id @default(cuid())
  bundleId   String
  productId  String
  sortOrder  Int     @default(0)

  bundle  Product @relation("BundleContents", fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation("InBundle", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

model Variant {
  id        String   @id @default(cuid())
  name      String
  price     Int
  stock     Int      @default(0)
  sku       String?  @unique
  productId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("variants")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING)
  total         Int
  shippingName  String
  shippingEmail String
  shippingPhone String?
  shippingAddr  String?
  paymentIntent String?
  razorpayOrderId String? @unique
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  items          OrderItem[]
  downloadEvents DownloadEvent[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  name      String
  price     Int
  quantity  Int
  image     String?
  isDigital Boolean @default(false)
  downloaded Boolean @default(false)
  productId String
  orderId   String

  product        Product         @relation(fields: [productId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  downloadEvents DownloadEvent[]

  @@map("order_items")
}

model DownloadEvent {
  id          String   @id @default(cuid())
  orderItemId String
  orderId     String
  fileName    String?
  ip          String?
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([orderId])
  @@map("download_events")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAID
  COMPLETED
  FAILED
  REFUNDED
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  discountType String
  value        Int
  minOrder     Int      @default(0)
  maxUses      Int      @default(0)
  usedCount    Int      @default(0)
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
  @@map("coupons")
}

model StoreSettings {
  id             String   @id @default(cuid())
  key            String   @unique
  value          String
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@map("store_settings")
}
